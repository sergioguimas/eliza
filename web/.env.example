# =============================================================================
# Eliza — variáveis de ambiente
# Copie para .env.local (dev) ou .env (VPS, lido pelo docker-compose).
# NEXT_PUBLIC_* são embutidas no bundle no `next build` — precisam existir na
# hora do build, não só no runtime do container.
# Segredos: gere com `openssl rand -hex 32`.
# =============================================================================

# --- Supabase (obrigatório) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Toda escrita em appointments passa por lib/domain com ela.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL do app --------------------------------------------------------------
# Usada em links (convites, lembretes) e no metadataBase.
# Sem ela, cai no header Origin da requisição.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Alias legado de NEXT_PUBLIC_APP_URL (só lida se a de cima estiver vazia).
# NEXT_PUBLIC_SITE_URL=

# --- Super-admin (god mode) --------------------------------------------------
# E-mail do usuário que acessa /admin e cria tenants. Mantenha as duas iguais.
GOD_EMAIL=
NEXT_PUBLIC_GOD_EMAIL=

# --- WhatsApp / Evolution API ------------------------------------------------
# Servidor único; a instância de cada org fica em organizations.whatsapp_instance_name.
EVOLUTION_API_URL=
# Alternativa aceita por compatibilidade com o deploy atual (use uma das duas).
# NEXT_PUBLIC_EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Segredo compartilhado com a Evolution no webhook. Sem ele o webhook recusa tudo.
WHATSAPP_WEBHOOK_SECRET=

# --- Cron (/api/cron/send-reminders, /api/cron/cleanup-demo) -----------------
# As rotas são públicas: use valor aleatório longo, nunca algo adivinhável.
CRON_SECRET=

# --- Demo (/demo/start) ------------------------------------------------------
# Instância Evolution usada nos envios do tour (nunca gravar na org demo).
DEMO_WHATSAPP_INSTANCE=
# Sal do hash dos identificadores (IP etc.) no rate limit da demo.
DEMO_RATE_LIMIT_SALT=

# --- API pública de catálogo (/api/public/v1) --------------------------------
# Origens com CORS liberado, separadas por vírgula, comparação exata (nunca *).
# Ex.: https://deborahpereira.com.br,https://www.deborahpereira.com.br
LP_PUBLIC_ORIGINS=

# --- Swagger (/api/v1/docs) --------------------------------------------------
# Em produção, "true" também publica a spec interna do autoatendimento.
API_DOCS_INTERNAS=false

# --- Autoatendimento (add-on do atendente / sola-agens) ----------------------
# Fica desligado enquanto ATENDENTE_URL estiver vazia.
# Token de serviço que o atendente envia como Bearer (mín. 32 caracteres).
AUTOATENDIMENTO_API_TOKEN=
# HMAC do ticket org+telefone emitido no webhook (mín. 32 caracteres).
AUTOATENDIMENTO_TICKET_SECRET=
# Base do serviço do atendente; o Eliza faz POST {ATENDENTE_URL}/v1/mensagens.
ATENDENTE_URL=
# HMAC das mensagens encaminhadas ao atendente.
ATENDENTE_ENCAMINHAMENTO_SECRET=

# --- Só desenvolvimento (testes manuais da API v1 com curl) ------------------
# Chaves de API de uma org de teste; o app não lê estas variáveis.
# ELIZA_TEST_API_KEY=
# ELIZA_TEST_API_KEY_PAYMENTS=

# --- Deploy (docker-compose na VPS) ------------------------------------------
# Host do router do Traefik (ex.: eliza.solasoftware.com.br).
DNS=
# IP fixo do container na rede evo_net, para a Evolution alcançar o app.
IP_EVO_NET=
